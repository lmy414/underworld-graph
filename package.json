{
  "name": "underworld-graph",
  "version": "0.3.1",
  "description": "Bi-temporal narrative state graph for fiction-writing engines.",
  "keywords": [
    "narrative",
    "story",
    "graph",
    "bi-temporal",
    "sqlite",
    "knowledge-graph",
    "fiction",
    "worldbuilding"
  ],
  "license": "MIT",
  "author": "lmy414",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmy414/underworld-graph.git"
  },
  "bugs": {
    "url": "https://github.com/lmy414/underworld-graph/issues"
  },
  "homepage": "https://github.com/lmy414/underworld-graph#readme",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": ["dist/", "src/", "README.md", "CHANGELOG.md", "LICENSE"],
  "dependencies": {
    "@nicia-ai/typegraph": "~0.40.0",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.36.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
